{
  "name": "open-executive-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js 15 web UI for Open Executive \u2014 an AI-powered virtual executive team.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/SenteLabsAI/OpenExecutive.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/SenteLabsAI/OpenExecutive#readme",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --experimental-strip-types --test scripts/*.test.mjs",
    "postinstall": "node scripts/apply-braces-depth.cjs",
    "predev": "node scripts/apply-braces-depth.cjs --check",
    "prebuild": "node scripts/apply-braces-depth.cjs --check",
    "prestart": "node scripts/apply-braces-depth.cjs --check",
    "pretest": "node scripts/apply-braces-depth.cjs --check",
    "test:geometry": "node --test scripts/reference-geometry.mjs",
    "test:read-errors": "node --test --test-reporter=junit scripts/read-error-states.mjs",
    "test:person-routes": "node --test --test-reporter=junit scripts/person-route-states.mjs",
    "test:review-details": "node --test --test-reporter=junit scripts/review-detail-states.mjs",
    "test:review-actions": "node --test --test-reporter=junit scripts/review-action-states.mjs",
    "test:review-changes": "node --test --test-reporter=junit scripts/review-change-states.mjs",
    "test:reference-async": "node --test --test-reporter=junit scripts/reference-async-states.mjs",
    "test:review-roles": "node --test --test-concurrency=1 --test-reporter=junit scripts/review-roles-proxy.mjs scripts/review-two-firms-proxy.mjs scripts/mermaid-consumer-proxy.mjs scripts/review-row-geometry.mjs scripts/mobile-geometry.mjs",
    "test:oct22-security": "node --test --test-reporter=junit scripts/oct22-dependency-security-browser.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.0",
    "@tailwindcss/typography": "^0.5.20",
    "@xyflow/react": "^12.11.6",
    "lucide-react": "^0.545.0",
    "mermaid": "^12.0.0",
    "next": "16.4.1",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.6",
    "eslint": "^10",
    "eslint-config-next": "16.4.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "playwright": "1.62.1"
  },
  "overrides": {
    "lodash-es": "^4.18.1",
    "@tailwindcss/typography": {
      "postcss-selector-parser": "7.1.6"
    },
    "mermaid": {
      "katex": "0.18.2",
      "dompurify": "3.4.17"
    }
  }
}
